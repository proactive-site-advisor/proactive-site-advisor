{
  "name": "mohammadyari/proactive-site-advisor",
  "description": "A high-quality WordPress plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Mohammad Yari",
      "email": "mohammad.yari.mail@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "yoast/phpunit-polyfills": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "ProactiveSiteAdvisor\\": "src/"
    }
  },
  "scripts": {
    "test": [
      "@test:unit",
      "@test:integration"
    ],
    "test:unit": "phpunit -c phpunit.xml.dist",
    "test:integration": "phpunit -c phpunit-integration.xml.dist"
  },
  "config": {
    "autoloader-suffix": "ProactiveSiteAdvisor",
    "platform": {
      "php": "7.4"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
